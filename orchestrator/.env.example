# Runline Bridge local environment example.
# Copy to .env for local development if your shell workflow loads dotenv files.
# Do not commit .env.

# Optional. The iOS app can also send the user's Cursor API key as a per-request bearer token.
CURSOR_API_KEY=

# Optional local override if supported by the installed bridge version.
RUNLINE_BRIDGE_HOST=127.0.0.1
RUNLINE_BRIDGE_PORT=8787

# Local development only. Keep pairing enabled for real device usage.
RUNLINE_BRIDGE_DISABLE_PAIRING=false

# Optional JSON array of bridge-side SDK profiles. Keep real MCP credentials private.
# Profiles can include mcpServers, agents, toolHints, skills, and hooks. The iOS app
# displays safe metadata while secrets and command environments stay on the bridge.
RUNLINE_SDK_MCP_PROFILES=[]
