{
  "name": "runline-bridge",
  "version": "0.1.0",
  "description": "Local Mac bridge for Runline Cursor SDK sessions.",
  "type": "module",
  "bin": {
    "runline-bridge": "./bin/runline-bridge.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "bridge": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "tag": "beta"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.11"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
