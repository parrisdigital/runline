{
  "name": "runline-bridge",
  "version": "0.1.4",
  "description": "Local Mac bridge for Runline Cursor SDK sessions.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/parrisdigital/runline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parrisdigital/runline.git",
    "directory": "orchestrator"
  },
  "bugs": {
    "url": "https://github.com/parrisdigital/runline/issues"
  },
  "keywords": [
    "cursor",
    "cursor-sdk",
    "ios",
    "runline",
    "bridge"
  ],
  "bin": {
    "runline-bridge": "bin/runline-bridge.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "tsc",
    "bridge": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "tag": "beta"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.12"
  },
  "overrides": {
    "sqlite3": "^6.0.1",
    "tar": "^7.5.14",
    "undici": "^6.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
