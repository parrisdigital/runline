# Local development only. Never commit real secrets.
PORT=8787
# Optional. When unset locally, the bridge uses an in-memory session store.
# On Fly, mount a volume at /data and set this path so SDK sessions can be
# listed and resumed after a Machine restart.
# RUNLINE_BRIDGE_SESSION_STORE_PATH=/data/runline-sdk-bridge/sessions.json
# Optional for private/self-hosted bridges only.
# RUNLINE_BRIDGE_AUTH_SECRET=replace-with-local-shared-secret
# Optional private prototype fallback only. Production requests should send the
# user's Cursor key per request from the iOS Keychain over HTTPS.
# CURSOR_API_KEY=replace-with-private-prototype-key
